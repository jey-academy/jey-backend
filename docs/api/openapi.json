    "/api/v1/audit-logs" : {
      "get" : {
        "operationId" : "auditLogs",
        "parameters" : [ {
          "description" : "그 일을 한 계정의 ID",
          "in" : "query",
          "name" : "actorId",
          "required" : false,
          "schema" : {
            "format" : "int64",
            "type" : "integer"
          }
        }, {
          "description" : "행위 이름. 정확히 일치하는 것만 찾는다",
          "in" : "query",
          "name" : "action",
          "required" : false,
          "schema" : {
            "maxLength" : 80,
            "minLength" : 0,
            "type" : "string"
          }
        }, {
          "description" : "DONE(한 일)이나 DENIED(거부된 시도)만 보려면 준다. 안 주면 둘 다",
          "in" : "query",
          "name" : "outcome",
          "required" : false,
          "schema" : {
            "enum" : [ "DONE", "DENIED" ],
            "type" : "string"
          }
        }, {
          "description" : "대상의 종류(예: student)",
          "in" : "query",
          "name" : "targetType",
          "required" : false,
          "schema" : {
            "maxLength" : 40,
            "minLength" : 0,
            "type" : "string"
          }
        }, {
          "description" : "대상의 ID. targetType과 같이 주어야 한다",
          "in" : "query",
          "name" : "targetId",
          "required" : false,
          "schema" : {
            "format" : "int64",
            "type" : "integer"
          }
        }, {
          "description" : "이 시각부터(포함). 시간대를 붙인 ISO 8601 형식",
          "example" : "2026-11-01T00:00:00+09:00",
          "in" : "query",
          "name" : "from",
          "required" : false,
          "schema" : {
            "format" : "date-time",
            "type" : "string"
          }
        }, {
          "description" : "이 시각 전까지(제외). 시간대를 붙인 ISO 8601 형식",
          "example" : "2026-12-01T00:00:00+09:00",
          "in" : "query",
          "name" : "to",
          "required" : false,
          "schema" : {
            "format" : "date-time",
            "type" : "string"
          }
        }, {
          "description" : "0부터",
          "in" : "query",
          "name" : "page",
          "required" : false,
          "schema" : {
            "default" : 0,
            "format" : "int32",
            "minimum" : 0,
            "type" : "integer"
          }
        }, {
          "in" : "query",
          "name" : "size",
          "required" : false,
          "schema" : {
            "default" : 20,
            "format" : "int32",
            "maximum" : 100,
            "minimum" : 1,
            "type" : "integer"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "*/*" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AuditLogPageResponse"
                }
              }
            },
            "description" : "OK"
          }
        },
